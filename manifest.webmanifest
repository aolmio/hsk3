{
  "id": "./",
  "name": "HSK Hub – Chinese study workspace",
  "short_name": "HSK Hub",
  "description": "HSK 1–9 vocabulary, grammar, flashcards, quizzes, stroke order and a pinyin analyzer. Works offline.",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#f4efe4",
  "theme_color": "#c43d2f",
  "lang": "en",
  "dir": "ltr",
